    {
      "name": "products",
      "item": [
        {
          "name": "getAll",
          "protocolProfileBehavior": {
            "disableCookies": false,
            "disableUrlEncoding": false,
            "followRedirects": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "admin_user_id",
                "value": "{{admin_user_id}}"
              }
            ],
            "url": "{{base_url}}{{products}}",
            "description": "GET /products (sem barra final): retorna cada produto da empresa do administrador uma vez. O campo category contém todas as categorias ativas disponíveis, inclusive ao filtrar por uma delas. Parâmetros opcionais: active=1|0|true|false, category_id=inteiro positivo, order=asc|desc (data de cadastro) e min_stock=inteiro não negativo (mínimo inclusivo de estoque). O campo stock é retornado em cada produto. Podem ser combinados. Sem order, mantém a ordem por ID; datas iguais usam ID crescente. Categorias inativas, inexistentes ou de outra empresa retornam []; parâmetros inválidos retornam 400. Exemplo: http://localhost:8000/products?active=1&category_id=2&order=desc. Parâmetro opcional lang, por exemplo ?lang=pt ou ?lang=pt-BR. Sem lang ou sem tradução correspondente, usa en; se não houver en, usa o título original em inglês. Códigos não distinguem maiúsculas de minúsculas; lang inválido retorna 400."
          },
          "response": []
        },
        {
          "name": "getOne",
          "protocolProfileBehavior": {
            "disableCookies": false,
            "disableUrlEncoding": false,
            "followRedirects": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "admin_user_id",
                "value": "{{admin_user_id}}"
              }
            ],
            "url": "{{base_url}}{{products}}/{{product_id}}",
            "description": "GET /products/{id}: retorna stock como inteiro não negativo. O campo category retorna uma lista com todas as categorias ativas disponíveis para o administrador (padrão e da sua empresa). Sem categorias, retorna []. Parâmetro opcional lang, por exemplo ?lang=pt ou ?lang=pt-BR. Sem lang ou sem tradução correspondente, usa en; se não houver en, usa o título original em inglês. Códigos não distinguem maiúsculas de minúsculas; lang inválido retorna 400."
          },
          "response": []
        },
        {
          "name": "insertOne",
          "protocolProfileBehavior": {
            "disableCookies": false,
            "disableUrlEncoding": false,
            "followRedirects": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "admin_user_id",
                "value": "{{admin_user_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_id\": {{company_id}},\n  \"title\": \"Sample product\",\n  \"price\": 123.4,\n  \"active\": true,\n  \"category_id\": {{category_id}},\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{products}}",
            "description": "POST /products: stock é opcional e assume 0 quando omitido."
          },
          "response": []
        },
        {
          "name": "updateOne",
          "protocolProfileBehavior": {
            "disableCookies": false,
            "disableUrlEncoding": false,
            "followRedirects": true
          },
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "admin_user_id",
                "value": "{{admin_user_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_id\": {{company_id}},\n  \"title\": \"Updated product\",\n  \"price\": 123.4,\n  \"active\": true,\n  \"category_id\": {{category_id}},\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{products}}/{{product_id}}",
            "description": "PUT /products/{id}: stock substitui o estoque atual; omitir preserva a quantidade. Os demais campos obrigatórios continuam exigidos."
          },
          "response": []
        },
        {
          "name": "deleteOne",
          "protocolProfileBehavior": {
            "disableCookies": false,
            "disableUrlEncoding": false,
            "followRedirects": true
          },
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "admin_user_id",
                "value": "{{admin_user_id}}"
              }
            ],
            "url": "{{base_url}}{{products}}/{{product_id}}"
          },
          "response": []
        }
      ]
