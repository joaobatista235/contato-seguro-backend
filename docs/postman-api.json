                "key": "admin_user_id",
                "value": "{{admin_user_id}}"
              }
            ],
            "url": "{{base_url}}{{products}}/{{product_id}}/comments/{{comment_id}}/likes",
            "description": "Curte comentário ou resposta disponível do produto. Retorna 200 com {\"liked\": true}. Uma curtida por administrador; repetir mantém a contagem. É permitido curtir o próprio comentário. 404 para produto ou comentário indisponível ou removido; 400 para IDs inválidos."
          },
          "response": []
        }
