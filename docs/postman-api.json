            "url": "{{base_url}}{{companies}}/{{company_id}}",
            "description": "GET /companies/{id}: retorna a empresa do administrador. Empresa inexistente ou diferente da empresa do administrador retorna 404."
          },
          "response": []
        }
      ]
    },
